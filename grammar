body            : NEWLINE* expr NEWLINE+


expr            : LBRACK body RBRACK
                : keyword-expr (EQ expr)*
                : KW:if expr expr (KW:elseif expr expr)* (KW:else expr)?

keyword-expr    : KW:wrn expr
                : KW:wr expr
                : KW:rd
                : KW:rdn
                : logical-expr

logical-expr    : comp-expr (KW:and|KW:or comp-expr)*

comp-expr       : arith-expr (LT|GT|EE|LTE|GTE arith-expr)*
                : KW:not comp-expr

arith-expr      : term (PLUS|MINUS term)*

term            : factor (MUL|DIV factor)*

factor          : INT|STR
                : (PLUS|MINUS|DOLLAR|QUES_MARK) factor
